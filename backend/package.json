{
    "name": "ludo-champion-api",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"{src,prisma,test}/**/*.ts\" --fix",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
        "test:watch": "jest --watch",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy && prisma generate",
        "db:seed": "tsx prisma/seed.ts",
        "smoke": "node scripts/smoke-test.mjs",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "verify": "npm run db:generate && npm run typecheck && npm test && npm run build",
        "db:prepare": "prisma migrate deploy && tsx prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/common": "11.1.28",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.28",
        "@nestjs/jwt": "11.0.1",
        "@nestjs/platform-express": "11.1.28",
        "@nestjs/platform-socket.io": "11.1.28",
        "@nestjs/schedule": "6.1.3",
        "@nestjs/swagger": "^11.4.5",
        "@nestjs/websockets": "11.1.28",
        "@prisma/adapter-pg": "7.9.0",
        "@prisma/client": "7.9.0",
        "argon2": "0.44.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "dotenv": "17.4.2",
        "helmet": "8.1.0",
        "ioredis": "5.7.0",
        "multer": "^2.2.0",
        "pg": "8.16.3",
        "prisma": "^7.9.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "socket.io": "4.8.3",
        "tsx": "4.20.3",
        "uuid": "^11.1.1",
        "zod": "4.0.17"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.1.28",
        "@types/express": "5.0.3",
        "@types/jest": "29.5.14",
        "@types/multer": "2.0.0",
        "@types/node": "24.2.0",
        "@types/pg": "8.15.5",
        "@types/supertest": "6.0.3",
        "eslint": "9.32.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "jest": "29.7.0",
        "prettier": "3.6.2",
        "source-map-support": "0.5.21",
        "supertest": "7.1.4",
        "ts-jest": "^29.4.1",
        "ts-loader": "9.5.2",
        "typescript": "5.9.2",
        "typescript-eslint": "8.39.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "type": "module",
    "overrides": {
        "@nestjs/swagger": {
            "js-yaml": "4.3.1"
        }
    }
}
